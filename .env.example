# ---------------------------------------------------------------------------
# mcp-news configuration
#
# Every value here is optional. With none of them set the system runs in
# Tier 0: it collects, deduplicates, stores, keyword-searches and ranks against
# your profile. Add providers later and run `mcpnews enrich --backlog` to
# process what you already collected.
# ---------------------------------------------------------------------------

# --- Local / private engines (tried first by default) ----------------------
# Any OpenAI-compatible server: llama.cpp, Ollama, LM Studio, vLLM, TEI.
LOCAL_CHAT_BASE_URL=
LOCAL_CHAT_MODEL=
LOCAL_CHAT_API_KEY=

LOCAL_EMBED_BASE_URL=
LOCAL_EMBED_MODEL=
LOCAL_EMBED_API_KEY=

# --- Cloud engines (failover, or make them primary in providers.yaml) ------
CLOUD_CHAT_BASE_URL=https://api.openai.com/v1
CLOUD_CHAT_MODEL=gpt-4o-mini
CLOUD_CHAT_API_KEY=

CLOUD_EMBED_BASE_URL=https://api.openai.com/v1
CLOUD_EMBED_MODEL=text-embedding-3-small
CLOUD_EMBED_API_KEY=

# --- Runtime ---------------------------------------------------------------
MCPNEWS_DATA_DIR=/data
MCPNEWS_ARCHIVE_DIR=/archive
MCPNEWS_PORT=8378
MCPNEWS_LOG_LEVEL=INFO

# Reader language. Foreign-language items are translated into this when a chat
# provider is available; untouched otherwise.
MCPNEWS_LANGUAGE=en

# Politeness. Raise only if you know what you are doing.
FETCH_CONCURRENCY=8
ENRICH_CONCURRENCY=4
